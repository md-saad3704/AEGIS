# ================================
# AEGIS - Git Ignore Configuration
# ================================

# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# React / frontend builds
dist/
build/
coverage/

# IDE / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated ML / simulation artifacts
models/
artifacts/
outputs/
runs/

# Temporary files
*.tmp
*.temp

# OS-specific files
*.swp
*.swo

# Geospatial datasets
data/lucknow/raw/
data/lucknow/processed/
